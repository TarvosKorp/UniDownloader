{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "UniDownloader",
  "version": "0.1.0",
  "identifier": "com.haldjarvi.unidownloader",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "UniDownloader",
        "width": 600,
        "height": 400,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["../../Icon.ico"],
    "externalBin": [
      "binaries/yt-dlp",
      "binaries/ffmpeg"
    ]
  }
}